# Runtime stage for minimal Debian 13 rootfs compatible with Firecracker
FROM debian:13

# Configure non-interactive installation
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal dependencies for Podman rootless and cloud-init
RUN apt-get update && apt-get install -y \
    podman \
    fuse-overlayfs \
    slirp4netns \
    cloud-init \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

# User setup for rootless
RUN useradd -m -s /bin/bash goose

# Configure cloud-init
COPY artifacts/cloud_init.yaml /etc/cloud/cloud.cfg.d/custom.cfg

USER goose

# Entry point for VM boot
ENTRYPOINT ["/bin/bash"]
