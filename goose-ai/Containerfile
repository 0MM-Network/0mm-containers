# Runtime stage for minimal Debian 13 rootfs compatible with Firecracker
FROM debian:13

# Configure non-interactive installation
ENV DEBIAN_FRONTEND=noninteractive

# Install minimal dependencies for Podman rootless and cloud-init, plus wget for downloading deb
RUN apt-get update && apt-get install -y \
    podman \
    fuse-overlayfs \
    slirp4netns \
    cloud-init \
    ca-certificates \
    curl \
    wget \
    && wget https://github.com/block/goose/releases/download/v1.7.0/goose_1.7.0_amd64.deb -O /tmp/goose.deb && \
    apt-get install -y /tmp/goose.deb && \
    rm /tmp/goose.deb && \
    rm -rf /var/lib/apt/lists/*

# User setup for rootless
RUN useradd -m -s /bin/bash goose

# Configure cloud-init
COPY artifacts/cloud_init.yaml /etc/cloud/cloud.cfg.d/custom.cfg

COPY artifacts/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

USER goose

# Entry point for VM boot
ENTRYPOINT ["/entrypoint.sh"]
