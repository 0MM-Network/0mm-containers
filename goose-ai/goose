#!/bin/bash

# Debug handling
set -x

# Define defaults
VM_MEMORY="1024M"
VM_CPUS=1
IMAGE_URL="https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img"
IMAGE_FILE="jammy-server-cloudimg-amd64.raw"
SHARED_DIR="./"
