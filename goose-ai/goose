#!/bin/bash

# Error handling
set -e
set -x

# Define defaults
VM_MEMORY="1024M"
VM_CPUS=4
IMAGE_URL="https://cloud-images.ubuntu.com/noble/current/noble-server-cloudimg-amd64.img"
IMAGE_FILE="noble-server-cloudimg-amd64.raw"
SHARED_DIR="./shared"
CONFIG_MOUNT="/mnt/share"
GOOSE_CONFIG="$CONFIG_MOUNT/config.yaml"
SERIAL_SOCK="./serial.sock"
API_SOCK="./api.sock"
CLOUD_INIT_IMG="cloud-init.img"
SIMPLIFIED_MODE=${SIMPLIFIED_MODE:-true}
HOST_IFACE=$(ip route get 8.8.8.8 | awk -- '{printf $5}' | head -n1)  # Detect default interface
MAC="12:34:56:78:90:ab"  # Default MAC from prompt
VERBOSE=false
LOG_FILE=""
VM_LOG="vm_log.txt"
VM_SERIAL_LOG="vm_serial.log"

# Function to display help
show_help() {
    echo "Usage: $0 --config <path/to/config.yaml> [subcommand] [--interactive] [-v] [--log <file>]"
    echo "  --config <path>     Mandatory: Path to config.yaml"
    echo "  subcommand          Optional: Goose subcommand (default: 'info')"
    echo "  --interactive       Optional: Force interactive REPL mode"
    echo "  -v                  Enable verbose mode"
    echo "  --log <file>        Log output to specified file"
    echo "  --help              Show this help message"
    exit 0
}

# Function to check dependencies and portability
check_deps() {
    local deps=("cloud-hypervisor" "virtiofsd" "socat" "mkdosfs" "mcopy" "qemu-img" "curl" "expect" "ip" "wget" "md5sum")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            echo "Error: $dep is required but not installed." >&2
            exit 1
        fi
    done

    # Check architecture (assume x86-64)
    if [ "$(uname -m)" != "x86_64" ]; then
        echo "Error: This script assumes x86-64 architecture." >&2
        exit 1
    fi

    # Check image compatibility (simple filename check for Noble)
    if [[ "$IMAGE_URL" != *"noble"* ]]; then
        echo "Warning: Image URL does not appear to be Ubuntu Noble; compatibility not guaranteed." >&2
    fi

    # Check if detected HOST_IFACE exists
    if [ -z "$HOST_IFACE" ] || ! ip link show "$HOST_IFACE" > /dev/null 2>&1; then
        echo "Error: Unable to detect a valid network interface. Please set HOST_IFACE manually." >&2
        exit 1
    fi
}

# Function to download and prepare the cloud image
download_image() {
    if [ ! -f "$IMAGE_FILE" ]; then
        wget "$IMAGE_URL" -O noble-server-cloudimg-amd64.img
        qemu-img convert -f qcow2 -O raw noble-server-cloudimg-amd64.img "$IMAGE_FILE"
        rm noble-server-cloudimg-amd64.img
    fi
}

# Function to create cloud-init image (adapt from create-cloud-init.sh, include Podman setup from cloud_init.yaml)
create_cloud_init() {
    rm -f "$CLOUD_INIT_IMG"
    mkdosfs -n CIDATA -C "$CLOUD_INIT_IMG" 8192

    # Get user's public SSH key (assume id_rsa.pub; fallback to empty)
    SSH_KEY=""
    if [ -f "$HOME/.ssh/id_rsa.pub" ]; then
        SSH_KEY=$(cat "$HOME/.ssh/id_rsa.pub")
    elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
        SSH_KEY=$(cat "$HOME/.ssh/id_ed25519.pub")
    fi

    # User-data with Podman rootless setup, users: goose, mounts, podman pull/run, and GOOSE_CONFIG in .profile
    # Security: Use SSH keys instead of passwords
    cat > user-data <<EOF
#cloud-config

package_update: true
package_upgrade: true

packages:
  - podman
  - fuse-overlayfs
  - slirp4netns
  - agetty
  - openssh-server

users:
  - default
  - name: goose
    ssh-authorized-keys:
      - $SSH_KEY
    shell: /bin/bash

write_files:
  - path: /etc/subuid
    content: |
      goose:100000:65536
  - path: /etc/subgid
    content: |
      goose:100000:65536
  - path: /home/goose/.config/systemd/user/podman.socket
    content: |
      [Unit]
      Description=Podman API Socket
      Documentation=man:podman-system-service(1)

      [Socket]
      ListenStream=%h/podman.sock
      SocketMode=0660

      [Install]
      WantedBy=sockets.target
    owner: goose
    group: goose
    permissions: '0644'
  - path: /home/goose/.profile
    append: true
    content: |
      export GOOSE_CONFIG=/mnt/share/config.yaml

runcmd:
  - SIMPLIFIED_MODE=$(grep -o "simplified_mode=true" /proc/cmdline || echo false)
  - if [ "$SIMPLIFIED_MODE" = "true" ]; then wget https://github.com/block/goose/releases/download/v1.7.0/goose_1.7.0_amd64.deb -O /tmp/goose.deb; apt install -y /tmp/goose.deb; rm /tmp/goose.deb; fi
  - mkdir -p /home/goose/src
  - mount -t virtiofs host_share /mnt/share
  - chown -R goose:goose /home/goose
  - systemctl start ssh
  - su - goose -c "systemctl --user daemon-reload"
  - su - goose -c "systemctl --user start podman.socket"
  - su - goose -c "podman pull ghcr.io/oraios/serena:latest"
  - su - goose -c "podman run --userns=keep-id -d -p 9121:9121 -p 24282:24282 --name serena ghcr.io/oraios/serena:latest serena start-mcp-server --transport stdio"
  - if [ "$SIMPLIFIED_MODE" != "true" ]; then if ! podman image exists localhost/goose:latest; then podman build -t localhost/goose:latest -f /mnt/share/Containerfile; fi; su - goose -c "podman run --userns=keep-id -d --name goose -v /mnt/share:/home/goose/workspace localhost/goose:latest goose session"; fi
  - agetty -s ttyS0  # Enable serial console for REPL
EOF

    # Basic meta-data
    echo "instance-id: iid-local01" > meta-data
    echo "local-hostname: vm" >> meta-data

    # Provided network-config for ens4 with MAC match
    cat > network-config <<EOF
version: 2
ethernets:
  ens4:
    match:
      macaddress: '$MAC'
    dhcp4: true
EOF

    # Copy to image (adapt from create-cloud-init.sh)
    for file in user-data meta-data network-config; do
        if ! mcopy -oi "$CLOUD_INIT_IMG" "$file" ::; then
            echo "Error: Failed to copy $file to cloud-init image" >&2
            exit 1
        fi
    done
    rm user-data meta-data network-config
}

# Function to setup virtiofs for shared directory (per fs.md)
setup_virtiofs() {
    mkdir -p "$SHARED_DIR"
    cp "$CONFIG" "$SHARED_DIR/config.yaml"
    sudo bash -c "ulimit -n 1000000 && /usr/libexec/virtiofsd --sandbox none --socket-path=virtiofs.sock --shared-dir \"$SHARED_DIR\" --cache=never --thread-pool-size=4 &"
    VIRTIOFSD_PID=$!
}

# Function to launch the VM (with --firmware, --disk, --fs, --net using MACVTAP bridge from macvtap-bridge.md)
launch_vm() {
    # Setup MACVTAP bridge (from macvtap-bridge.md)
    # Clean up existing macvtap0 if it exists
    if ip link show macvtap0 > /dev/null 2>&1; then
        sudo ip link delete macvtap0
    fi
    sudo ip link add link "$HOST_IFACE" name macvtap0 type macvtap mode bridge
    sudo ip link set macvtap0 address "$MAC" up
    TAP_FD=$(cat /sys/class/net/macvtap0/ifindex)
    TAP_DEVICE="/dev/tap$TAP_FD"
    sudo chown "$UID:$UID" "$TAP_DEVICE"

    # Clean up existing API socket if it exists
    if [ -S "$API_SOCK" ]; then
        rm -f "$API_SOCK"
    fi

    # Launch Cloud Hypervisor
    cloud-hypervisor \
        --cpus boot=$VM_CPUS \
        --memory size=$VM_MEMORY,shared=on \
        --firmware /usr/share/cloud-hypervisor/hypervisor-fw \
        --disk path=$IMAGE_FILE path=$CLOUD_INIT_IMG \
        --fs tag=host_share,socket=virtiofs.sock,num_queues=1,queue_size=512 \
        --net fd=3,mac=$MAC 3<>$TAP_DEVICE \
        --serial socket="$SERIAL_SOCK" \
        --console off \
        --api-socket "$API_SOCK" &
    VM_PID=$!

    # Poll for API socket with vmm.ping
    for i in {1..60}; do
        if [ -S "$API_SOCK" ] && curl --unix-socket "$API_SOCK" -s http://localhost/vmm.ping > /dev/null; then
            break
        fi
        sleep 1
    done
    if [ ! -S "$API_SOCK" ]; then
        echo "Error: API socket timeout" >&2
        exit 1
    fi

    # Boot the VM using curl
    curl --unix-socket "$API_SOCK" -X PUT http://localhost/vm.boot

    # Poll for serial socket
    for i in {1..60}; do
        if [ -S "$SERIAL_SOCK" ]; then
            break
        fi
        sleep 1
    done
    if [ ! -S "$SERIAL_SOCK" ]; then
        echo "Error: Serial socket timeout" >&2
        exit 1
    fi
}

# Function for interactive VM mode
interact_vm() {
    socat -,raw,echo=0,escape=0x1f UNIX-CONNECT:"$SERIAL_SOCK" || echo "Serial attachment failed" >&2

    # After detach, send poweroff using expect
    expect <<EOF
    set timeout 60
    spawn socat - UNIX-CONNECT:"$SERIAL_SOCK"
    expect "goose@vm:~$"
    send "sudo poweroff\r"
    expect eof
EOF
}

# Function to run command in guest (send 'goose' sub-command via serial or expect)
run_guest_command() {
    local subcommand="${POSITIONAL[*]:-info}"
    local command="GOOSE_CONFIG=$GOOSE_CONFIG goose $subcommand"
    if [ "$SIMPLIFIED_MODE" = "true" ]; then
        command="$command"  # Direct
    else
        command="podman exec goose $command"  # Assuming container named goose
    fi

    # Send command via expect (non-interactive)
    expect <<EOF
    set timeout 60
    spawn socat - UNIX-CONNECT:"$SERIAL_SOCK"
    expect "goose@vm:~$"
    send "$command\r"
    send "echo DONE\r"
    send "sudo poweroff\r"
    expect "DONE"
    expect eof
EOF
}

# Function to sync back config if modified
sync_back_config() {
    original_md5=$(md5sum "$CONFIG" | cut -d' ' -f1)
    shared_md5=$(md5sum "$SHARED_DIR/config.yaml" | cut -d' ' -f1)
    if [ "$original_md5" != "$shared_md5" ]; then
        cp "$SHARED_DIR/config.yaml" "$CONFIG"
        echo "Config changes synced back to $CONFIG"
    fi
}

# Main logic

# Parse arguments
CONFIG=""
INTERACTIVE=false
declare -a POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --config=*)
            CONFIG="${key#*=}"
            shift
            ;;
        --config)
            CONFIG="$2"
            shift 2
            ;;
        --interactive)
            INTERACTIVE=true
            shift
            ;;
        -v)
            VERBOSE=true
            shift
            ;;
        --log)
            LOG_FILE="$2"
            shift 2
            ;;
        --help)
            show_help
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
set -- "${POSITIONAL[@]}"

# Enable verbose if -v
if $VERBOSE; then
    set -x
fi

# Redirect to log file if specified
if [ -n "$LOG_FILE" ]; then
    exec > >(tee -a "$LOG_FILE") 2>&1
fi

# Require --config
if [ -z "$CONFIG" ]; then
    echo "Error: --config <file/path.yaml> is required." >&2
    exit 1
fi

# Check config file exists
if [ ! -f "$CONFIG" ]; then
    echo "Error: Specified config file $CONFIG not found." >&2
    exit 1
fi

# Add /usr/libexec and /sbin to PATH for virtiofsd and mkdosfs
export PATH="$PATH:/usr/libexec:/sbin"

# Check deps and portability
check_deps

# Download image
download_image

# Create cloud-init
create_cloud_init

# Setup virtiofs
setup_virtiofs

# Launch VM
launch_vm

# Trap for cleanup and sync
trap 'curl --unix-socket "$API_SOCK" -X PUT http://localhost/vm.shutdown; kill $VM_PID $VIRTIOFSD_PID; rm -f "$CLOUD_INIT_IMG" virtiofs.sock "$API_SOCK" "$SERIAL_SOCK"; sudo ip link delete macvtap0; sync_back_config' EXIT ERR INT TERM

# Check for interactive mode
if $INTERACTIVE || [[ "${POSITIONAL[0]}" == "repl" ]] || [ -t 0 ] && [ -t 1 ]; then
    interact_vm
else
    run_guest_command
fi
