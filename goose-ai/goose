#!/bin/bash

# Debug handling
set -x

# Define defaults
VM_MEMORY="1024M"
VM_CPUS=1
IMAGE_URL="https://cloud-images.ubuntu.com/jammy/current/jammy-server-cloudimg-amd64.img"
IMAGE_FILE="jammy-server-cloudimg-amd64.raw"
SHARED_DIR="./"
CONFIG_MOUNT="/home/goose/src"
GOOSE_CONFIG="$CONFIG_MOUNT/config.yaml"
GOOSE_DIR=".goose"
SERIAL_SOCK="$GOOSE_DIR/serial.sock"
API_SOCK="$GOOSE_DIR/api.sock"
VIRTIOFS_SOCK="$GOOSE_DIR/virtiofs.sock"
LOCK_FILE="$GOOSE_DIR/setup.lock"
CLOUD_INIT_IMG="cloud-init.img"
SERIAL_LOG="serial.log"
SIMPLIFIED_MODE=${SIMPLIFIED_MODE:-true}
HOST_IFACE=$(ip route get 8.8.8.8 | awk -- '{printf $5}' | head -n1)  # Detect default interface
MAC="12:34:56:78:90:ab"  # Default MAC from prompt
VERBOSE=false
LOG_FILE=""
VM_LOG="vm_log.txt"
MAX_TIMEOUT_IP=${MAX_TIMEOUT_IP:-60}  # Configurable via env var, default 60s for dev/test

# Function to display help
show_help() {
    echo "Usage: $0 --config <path/to/config.yaml> [subcommand] [--interactive] [-v] [--log <file>]"
    echo "  --config <path>     Mandatory: Path to config.yaml"
    echo "  subcommand          Optional: Goose subcommand (default: 'info')"
    echo "  --interactive       Optional: Force interactive REPL mode"
    echo "  -v                  Enable verbose mode"
    echo "  --log <file>        Log output to specified file"
    echo "  --help              Show this help message"
    exit 0
}

# Function to check dependencies and portability
check_deps() {
    local deps=("cloud-hypervisor" "virtiofsd" "socat" "mkdosfs" "mcopy" "qemu-img" "curl" "expect" "ip" "wget" "md5sum")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            echo "Error: $dep is required but not installed." >&2
            exit 1
        fi
    done

    # Check architecture (assume x86-64)
    if [ "$(uname -m)" != "x86_64" ]; then
        echo "Error: This script assumes x86-64 architecture." >&2
        exit 1
    fi

    # Check image compatibility (simple filename check for jammy)
    if [[ "$IMAGE_URL" != *"jammy"* ]]; then
        echo "Warning: Image URL does not appear to be Ubuntu jammy; compatibility not guaranteed." >&2
    fi

    # Check if detected HOST_IFACE exists
    if [ -z "$HOST_IFACE" ] || ! ip link show "$HOST_IFACE" > /dev/null 2>&1; then
        echo "Error: Unable to detect a valid network interface. Please set HOST_IFACE manually." >&2
        exit 1
    fi
}

# Function to download and prepare the cloud image
download_image() {
    if [ ! -f "$IMAGE_FILE" ]; then
        if [ ! -f jammy-server-cloudimg-amd64.img ]; then
            wget "$IMAGE_URL" -O jammy-server-cloudimg-amd64.img
        fi
        qemu-img convert -p -f qcow2 -O raw jammy-server-cloudimg-amd64.img "$IMAGE_FILE"
        qemu-img resize -f raw "$IMAGE_FILE" 10G
        # rm jammy-server-cloudimg-amd64.img
    fi
}

# Function to create cloud-init image (merged from 1 and 2)
create_cloud_init() {
    rm -f "$CLOUD_INIT_IMG"
    mkdosfs -n CIDATA -C "$CLOUD_INIT_IMG" 8192

    # Generate isolated SSH keys in current working directory (if not already present)
    if [ ! -f "./vm_root_id_rsa" ]; then
        ssh-keygen -t rsa -b 2048 -f ./vm_root_id_rsa -N "" -C "VM root key" -q
        echo "Generated SSH keys: ./vm_root_id_rsa (private) and ./vm_root_id_rsa.pub (public)"
    fi

    # Read the public key
    SSH_PUB_KEY=$(cat ./vm_root_id_rsa.pub)

    # Get user's public SSH key (assume id_rsa.pub; fallback to empty)
    SSH_KEY=""
    if [ -f "$HOME/.ssh/id_rsa.pub" ]; then
        SSH_KEY=$(cat "$HOME/.ssh/id_rsa.pub")
    elif [ -f "$HOME/.ssh/id_ed25519.pub" ]; then
        SSH_KEY=$(cat "$HOME/.ssh/id_ed25519.pub")
    fi

    # Merged user-data
    cat > user-data <<EOF
#cloud-config
package_update: false
package_upgrade: false

packages:
  - openssh-server
  - sed
  - podman
  - fuse-overlayfs
  - slirp4netns

users:
  - name: root
    lock_passwd: false
  - default
  - name: goose
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash

write_files:
  - path: /etc/systemd/system/serial-getty@ttyS0.service.d/override.conf
    content: |
      [Service]
      ExecStart=
      ExecStart=-/sbin/agetty --autologin root --noclear --keep-baud 115200,38400,9600 %I dumb
    permissions: '0644'
  - path: /root/.ssh/authorized_keys
    content: |
      $SSH_PUB_KEY
    permissions: '0600'
    owner: root:root
  - path: /etc/subuid
    content: |
      goose:100000:65536
    permissions: '0644'
  - path: /etc/subgid
    content: |
      goose:100000:65536
    permissions: '0644'
  - path: /home/goose/.config/systemd/user/podman.socket
    content: |
      [Unit]
      Description=Podman API Socket
      Documentation=man:podman-system-service(1)

      [Socket]
      ListenStream=%h/podman.sock
      SocketMode=0660

      [Install]
      WantedBy=sockets.target
    owner: goose:goose
    permissions: '0644'
  - path: /home/goose/.profile
    append: true
    content: |
      export GOOSE_CONFIG=/home/goose/src/config.yaml

runcmd:
  - [sed, -i, 's/^#PermitRootLogin .*/PermitRootLogin yes/', /etc/ssh/sshd_config]
  - [sed, -i, 's/^PermitRootLogin .*/PermitRootLogin yes/', /etc/ssh/sshd_config]
  - [mkdir, -p, /root/.ssh]
  - [chmod, '700', /root/.ssh]
  - [systemctl, restart, ssh]  # Or sshd if distro variant
  - [sh, -c, 'echo "SSH root auto-login configured with key: $SSH_PUB_KEY" >> /var/log/cloud-init-ssh-setup.log']
  - [systemctl, daemon-reload]
  - [systemctl, enable, serial-getty@ttyS0.service]
  - [systemctl, restart, serial-getty@ttyS0.service]
  - apt clean && growpart /dev/vda 1 && resize2fs /dev/vda1
  - apt update && apt install -y podman fuse-overlayfs slirp4netns
  - curl -fsSL https://github.com/block/goose/releases/download/stable/download_cli.sh | CONFIGURE=false bash
  - mkdir -p /home/goose/src
  - mount -t virtiofs host_share /home/goose/src
  - chown -R goose:goose /home/goose
  - su - goose -c "export HOME=/home/goose; systemctl --user daemon-reload"
  - su - goose -c "export HOME=/home/goose; systemctl --user restart podman.socket"
EOF

    # Basic meta-data
    echo "instance-id: iid-local01" > meta-data
    echo "local-hostname: vm" >> meta-data

    # Provided network-config for ens4 with MAC match
    cat > network-config <<EOF
version: 2
ethernets:
  ens3:
    match:
      macaddress: '$MAC'
    dhcp4: true
    dhcp6: true
EOF

    # Copy to image
    for file in user-data meta-data network-config; do
        if ! mcopy -oi "$CLOUD_INIT_IMG" -s "$file" ::; then
            echo "Error: Failed to copy $file to cloud-init image" >&2
            exit 1
        fi
    done
    # Clean up temporary files
    #rm -f user-data meta-data network-config
}

# Function to check if setup is valid or stale
check_setup() {
    if [ ! -f "$LOCK_FILE" ]; then
        return 1
    fi
    source "$LOCK_FILE" && [ -n "$VIRTIOFSD_PID" ] || { echo "Error: Invalid or corrupted lock file" >> "$VM_LOG" >&2; exit 1; }

    # Check if processes are running
    if ! kill -0 "$VIRTIOFSD_PID" 2>/dev/null; then
        return 1
    fi

    # Check if sockets exist and are responsive
    if [ ! -S "$VIRTIOFS_SOCK" ]; then
        return 1
    fi

    # Check MACVTAP
    if ! ip link show macvtap0 > /dev/null 2>&1; then
        return 1
    fi

    return 0
}

# Function to handle setup (reuse or recreate if stale)
handle_setup() {
    if check_setup; then
        echo "Reusing existing setup." >> "$VM_LOG"
    else
        echo "Setup stale or missing. Recreating..." >> "$VM_LOG"
        ./goose-setup.sh --teardown || true  # Clean up any partial state
        ./goose-setup.sh --setup
    fi
}

# Modularized: Prepare resources before starting hypervisor
prepare_resources() {
    # Get TAP details
    TAP_FD=$(< /sys/class/net/macvtap0/ifindex)
    TAP_DEVICE="/dev/tap$TAP_FD"

    # Clean up existing API socket if it exists
    rm -f "$API_SOCK" || true
}

# Modularized: Start the hypervisor
start_hypervisor() {
    local serial_opt="--serial file=$SERIAL_LOG"
    if $SERIAL; then
        serial_opt="--serial tty"
    fi

    cloud-hypervisor --cpus boot=$VM_CPUS \
        --memory size=$VM_MEMORY,shared=on \
        --firmware /usr/share/cloud-hypervisor/hypervisor-fw \
        --disk path=$IMAGE_FILE path=$CLOUD_INIT_IMG \
        --fs tag=host_share,socket="$VIRTIOFS_SOCK",num_queues=1,queue_size=512 \
        $serial_opt \
        --console off \
        --api-socket "$API_SOCK" \
        --net fd=3,mac=$MAC 3<>"$TAP_DEVICE" &
    VM_PID=$!

    # Check if launch succeeded
    if [ $? -ne 0 ]; then
        echo "Error: Failed to start cloud-hypervisor" >> "$VM_LOG" >&2
        exit 1
    fi

    # Wait a bit for process to start
    sleep 1
    if ! kill -0 $VM_PID 2>/dev/null; then
        echo "Error: cloud-hypervisor process failed to start" >> "$VM_LOG" >&2
        exit 1
    fi
}

# Modularized: Wait for resources (API, IP, SSH)
wait_resources() {
    local api_poll_max=60
    local ssh_poll_max=60
    if $TEST_MODE; then
        api_poll_max=10
        ssh_poll_max=10
        echo "Test mode: Reduced poll max to $api_poll_max" >> "$VM_LOG"
    fi

    # Poll for API socket with vmm.ping
    for i in {1..$api_poll_max}; do
        echo "Polling API socket (attempt $i/$api_poll_max)..." >> "$VM_LOG"
        if [ -S "$API_SOCK" ] && curl --unix-socket "$API_SOCK" -s http://localhost/vmm.ping > /dev/null; then
            echo "API socket ready after $i attempts." >> "$VM_LOG"
            break
        fi
        sleep 1
    done
    if [ ! -S "$API_SOCK" ]; then
        echo "Error: API socket timeout" >> "$VM_LOG" >&2
        exit 1
    fi

    # Wait for IP using serial log parsing
    VM_IP=$(wait_for_ip)
    if [ $? -eq 0 ] && [ -n "$VM_IP" ]; then
        echo "Extracted VM IP: $VM_IP" >> "$VM_LOG"
    else
        echo "Failed to extract VM IP." >> "$VM_LOG" >&2
        exit 1
    fi

    # Wait for SSH readiness
    echo "Waiting for SSH readiness..." >> "$VM_LOG"
    for i in {1..$ssh_poll_max}; do
        echo "Polling SSH (attempt $i/$ssh_poll_max)..." >> "$VM_LOG"
        if [ -n "$VM_IP" ] && nc -z -w2 "$VM_IP" 22; then  # Check if port 22 is open
            echo "VM ready at IP $VM_IP with SSH available after $i attempts." >> "$VM_LOG"
            export SSH_READY=yes
            break
        fi
        sleep 10
    done
    if [ -z "$SSH_READY" ]; then
        echo "Error: Timeout waiting for VM IP/SSH - check network setup." >> "$VM_LOG" >&2
        exit 1
    fi
}

# Function to wait for IP via serial log parsing
wait_for_ip() {
    local timeout_ip=$MAX_TIMEOUT_IP
    if $TEST_MODE; then
        timeout_ip=10
        echo "Test mode: Reduced IP timeout to $timeout_ip" >> "$VM_LOG"
    fi
    for ((i=1; i<=$timeout_ip; i++)); do
        echo "Waiting for IP from serial log (attempt $i/$timeout_ip)..." >> "$VM_LOG"
        VM_IP=$(grep -oE 'inet [0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$SERIAL_LOG" | tail -1 | awk '{print $2}')
        if [ -n "$VM_IP" ]; then
            echo "$VM_IP"
            return 0
        fi
        sleep 1
    done
    echo "Error: Timeout after $timeout_ip seconds. IP not found in serial log." >> "$VM_LOG" >&2
    return 1
}

# Function for interactive VM mode
interact_vm() {
    if $SERIAL; then
        socat -,raw,echo=0,escape=0x1f UNIX-CONNECT:"$SERIAL_SOCK" || echo "Serial attachment failed" >&2
    else
        # Interactive SSH session as root using generated key
        echo "Connecting to VM at $VM_IP via SSH as root..."
        for i in {1..10}; do
            if ssh -i ./vm_root_id_rsa -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@"$VM_IP"; then
                break
            fi
            echo "SSH connection attempt $i failed; retrying in 5s..."
            sleep 5
        done || { echo "Error: Failed to connect via SSH - check VM logs." >&2; exit 1; }
    fi
}

# Function to run command in guest (send 'goose' sub-command via serial or expect)
run_guest_command() {
    local subcommand="${POSITIONAL[*]:-info}"
    local command="GOOSE_CONFIG=$GOOSE_CONFIG goose $subcommand"
    if [ "$SIMPLIFIED_MODE" = "true" ]; then
        command="$command"  # Direct
    else
        command="podman exec goose $command"  # Assuming container named goose
    fi

    # Send command via expect (non-interactive)
    expect <<EOF
    set timeout 60
    spawn socat - UNIX-CONNECT:"$SERIAL_SOCK"
    expect "root@vm:~#"
    send "$command\r"
    send "echo DONE\r"
    send "sudo poweroff\r"
    expect "DONE"
    expect eof
EOF
}

# Function to sync back config if modified
sync_back_config() {
    original_md5=$(md5sum "$CONFIG" | cut -d' ' -f1)
    shared_md5=$(md5sum "$SHARED_DIR/config.yaml" | cut -d' ' -f1)
    if [ "$original_md5" != "$shared_md5" ]; then
        cp "$SHARED_DIR/config.yaml" "$CONFIG"
        echo "Config changes synced back to $CONFIG"
    fi
}

# Cleanup function for traps
cleanup_vm() {
    echo "Cleaned up on signal" >> "$VM_LOG"
    pkill -P $$ || true  # Kill child processes
    rm -f "$API_SOCK" "$SERIAL_SOCK" "$SERIAL_LOG" || true
    sync_back_config
}

# Main logic

# Parse arguments
CONFIG=""
INTERACTIVE=false
SERIAL=false
SUDO_SETUP=false
SUDO_TEARDOWN=false
NO_TRAP=false
TEST_MODE=false
declare -a POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --config=*)
            CONFIG="${key#*=}"
            shift
            ;;
        --config)
            CONFIG="$2"
            shift 2
            ;;
        --interactive)
            INTERACTIVE=true
            shift
            ;;
        --serial)
            SERIAL=true
            shift
            ;;
        --sudo-setup)
            SUDO_SETUP=true
            shift
            ;;
        --sudo-teardown)
            SUDO_TEARDOWN=true
            shift
            ;;
        --no-trap)
            NO_TRAP=true
            shift
            ;;
        --test-mode)
            TEST_MODE=true
            shift
            ;;
        -v)
            VERBOSE=true
            shift
            ;;
        --log)
            LOG_FILE="$2"
            shift 2
            ;;
        --help)
            show_help
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
set -- "${POSITIONAL[@]}"

# If test mode, enable verbose and short timeouts
if $TEST_MODE; then
    VERBOSE=true
    MAX_TIMEOUT_IP=10
fi

# Enable verbose if -v
if $VERBOSE; then
    set -x
fi

# Redirect to log file if specified
if [ -n "$LOG_FILE" ]; then
    exec > >(tee -a "$LOG_FILE") 2>&1
fi

# Handle special flags
if $SUDO_SETUP; then
    ./goose-setup.sh --setup
    exit 0
fi
if $SUDO_TEARDOWN; then
    ./goose-setup.sh --teardown
    exit 0
fi

# Require --config
if [ -z "$CONFIG" ]; then
    echo "Error: --config <file/path.yaml> is required." >&2
    exit 1
fi

# Check config file exists
if [ ! -f "$CONFIG" ]; then
    echo "Error: Specified config file $CONFIG not found." >&2
    exit 1
fi

# Add /usr/libexec and /sbin to PATH for virtiofsd and mkdosfs
export PATH="$PATH:/usr/libexec:/sbin"

# Check deps and portability
check_deps

# Prepare shared dir
mkdir -p "$SHARED_DIR"
cp "$CONFIG" "$SHARED_DIR/config.yaml"

# Handle setup (reuse or recreate)
handle_setup

# Download image
download_image

# Create cloud-init
create_cloud_init

# Launch VM modularly
prepare_resources
start_hypervisor
wait_resources

# Trap for cleanup and sync
if ! $NO_TRAP; then
    trap "cleanup_vm; exit 1" EXIT ERR INT TERM
fi

# Check for interactive mode
if $INTERACTIVE || [[ "${POSITIONAL[0]}" == "repl" ]] || ([ ${#POSITIONAL[@]} -eq 0 ] && [ -t 0 ] && [ -t 1 ]); then
    interact_vm
else
    run_guest_command
fi
