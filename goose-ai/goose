# Function to setup virtiofs for shared directory (per fs.md)
setup_virtiofs() {
    mkdir -p "$SHARED_DIR"
    cp "$CONFIG" "$SHARED_DIR/config.yaml"
    sudo bash -c "ulimit -n 1000000 && /usr/libexec/virtiofsd --sandbox none --socket-path=virtiofs.sock --shared-dir \"$SHARED_DIR\" --cache=never --thread-pool-size=4 &"
    VIRTIOFSD_PID=$!

    # Poll for virtiofs.sock
    for i in {1..30}; do
        if [ -S "virtiofs.sock" ]; then
            break
        fi
        sleep 1
    done
    if [ ! -S "virtiofs.sock" ]; then
        echo "Error: virtiofs.sock timeout" >&2
        exit 1
    fi
    sudo chmod 666 virtiofs.sock
}

# Function to launch the VM (with --firmware, --disk, --fs, --net using MACVTAP bridge from macvtap-bridge.md)
launch_vm() {
    # Setup MACVTAP bridge (from macvtap-bridge.md)
    # Clean up3existing macvtap0 if it exists
    if ip link show macvtap0 > /dev/null 2>&1; then
        sudo ip link delete macvtap0
    fi
    sudo ip link add link "$HOST_IFACE" name macvtap0 type macvtap
    sudo ip link set macvtap0 address "$MAC" up promisc on
    sudo ip link show macvtap0
    TAP_FD=$(< /sys/class/net/macvtap0/ifindex)
    TAP_DEVICE="/dev/tap$TAP_FD"
    sudo chown "$UID:$UID" "$TAP_DEVICE"

    # Clean up existing API socket if it exists
    cloud-hypervisor --cpus boot=$VM_CPUS \
        --memory size=$VM_MEMORY,shared=on \
        --firmware /usr/share/cloud-hypervisor/hypervisor-fw \
        --disk path=$IMAGE_FILE path=$CLOUD_INIT_IMG_1 \
        --fs tag=host_share,socket=virtiofs.sock,num_queues=1,queue_size=512 \
        --serial socket="$SERIAL_SOCK" \
        --console off \
        --api-socket "$API_SOCK" \
        --net fd=3,mac=$MAC 3<>$"$TAP_DEVICE" &
    VM_PID=$!

    # Poll for API socket with vmm.ping
    for i in {1..60}; do
        if [ -S "$API_SOCK" ] && curl --unix-socket "$API_SOCK" -s http://localhost/vmm.ping > /dev/null; then
            break
        fi
        sleep 1
    done
    if [ ! -S "$API_SOCK" ]; then
        echo "Error: API socket timeout" >&2
        exit 1
    fi

    # Boot the VM using curl (only if launched in paused state)
    #curl --unix-socket "$API_SOCK" -X PUT http://localhost/vm.boot

    # Wait for IP
    VM_IP=$(wait_and_extract_vm_ip)
    if [ $? -eq 0 ] && [ -n "$VM_IP" ]; then
        echo "Extracted VM IP: $VM_IP"
    else
        echo "Failed to extract VM IP."
        exit 1
    fi

    echo "Waiting for SSH readiness..."
    for i in {1..60}; do
        if [ -n "$VM_IP" ] && nc -z -w2 "$VM_IP" 22; then  # Check if port 22 is open
            echo "VM ready at IP $VM_IP with SSH available."
            export SSH_READY=yes
            break
        fi
        sleep 10
    done
    if [ -z "$SSH_READY" ]; then
        echo "Error: Timeout waiting for VM IP/SSH - check network setup." >&2
        exit 1
    fi
}

# Robust script to extract IPv4 address associated with a specific MAC from vm_serial.log
# Handles binary files by cleaning null bytes, parses the cloud-init table format,
# and is robust to streaming by using tail -f with timeout to monitor new appended lines until found.

# Function to extract IP from a matched line
extract_ip_from_line() {
    local line="$1"

    # Parse the line: Assume format "| DEVICE | UP | ADDRESS | MASK | SCOPE | HW-ADDRESS |"
    # Use awk to split by '|' and trim spaces, extract the address field (3rd column after split)
    # Use awk to find IPv4 pattern immediately before the MAC field in the line
    # Use awk with a here-document for the script to avoid quoting issues
    IP=$(echo "$line" | awk -v mac="$TARGET_MAC" '
BEGIN {
    # (Optional: Any initialization)
}
{
    # Normalize: remove extra spaces, split by "|"
    gsub(/[ \t]+/, " ");
    split($0, fields, "|");

    # Scan fields for MAC match
    for (i = 1; i <= length(fields); i++) {
        if (tolower(fields[i]) ~ tolower(mac)) {
            # IP is likely 3 fields before MAC (ADDRESS field, skipping UP and DEVICE)
            if (i >= 4) {
                candidate = fields[i-3];  # Adjust offset based on table (DEVICE|UP|ADDRESS|MASK|SCOPE|HW)
                gsub(/[ \t]+/, "", candidate);  # Trim
                # Validate as IPv4
                if (candidate ~ /^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$/) {
                    print candidate;
                    exit 0;
                }
            }
        }
    }
    exit 1;
}
')
    if [ -n "$IP" ]; then
        echo "$IP"
        return 0
    fi
    return 1
}

# Main function to tail the streaming log with timeout until IP is found
wait_and_extract_vm_ip() {
    #echo "Monitoring $VM_SERIAL_LOG for IP associated with MAC $MAC (timeout: $MAX_TIMEOUT_IP seconds)..."

    # Use timeout to bound tail -f; clean null bytes and grep for MAC, then parse
    timeout "$MAX_TIMEOUT_IP" tail -f "$VM_SERIAL_LOG" | strings | while read -r line; do
        if echo "$line" | grep -iq "$MAC"; then
            IP=$(extract_ip_from_line "$line")
            if [ $? -eq 0 ]; then
                echo "$IP"
                # Kill the tail process to exit cleanly (use pkill or break)
                pkill -P $$ tail
                return 0
            fi
        fi
    done

    # If timeout or no match
    if [ $? -eq 124 ]; then  # timeout exit code
        echo "Error: Timeout after $MAX_TIMEOUT_IP seconds. MAC $MAC or IP not found." >&2
        return 1
    fi
    return 0  # Success if found before timeout
}

# Function for interactive VM mode
interact_vm() {

    socat -,raw,echo=0,escape=0x1f UNIX-CONNECT:"$SERIAL_SOCK" || echo "Serial attachment failed" >&2

    # Interactive SSH session as root using generated key
    echo "Connecting to VM at $VM_IP via SSH as root..."
    for i in {1..10}; do
        if ssh -i ./vm_root_id_rsa -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null root@"$VM_IP"; then
            break
        fi
        echo "SSH connection attempt $i failed; retrying in 5s..."
        sleep 5
    done || { echo "Error: Failed to connect via SSH - check VM logs." >&2; exit 1; }

    # socat -,raw,echo=0,escape=0x1f UNIX-CONNECT:"$SERIAL_SOCK" || echo "Serial attachment failed" >&2
}

# Function to run command in guest (send 'goose' sub-command via serial or expect)
run_guest_command() {
    local subcommand="${POSITIONAL[*]:-info}"
    local command="GOOSE_CONFIG=$GOOSE_CONFIG goose $subcommand"
    if [ "$SIMPLIFIED_MODE" = "true" ]; then
        command="$command"  # Direct
    else
        command="podman exec goose $command"  # Assuming container named goose
    fi

    # Send command via expect (non-interactive)
    expect <<EOF
    set timeout 60
    spawn socat - UNIX-CONNECT:"$SERIAL_SOCK"
    expect "goose@vm:~$"
    send "$command\r"
    send "echo DONE\r"
    send "sudo poweroff\r"
    expect "DONE"
    expect eof
EOF
}

# Function to sync back config if modified
sync_back_config() {
    original_md5=$(md5sum "$CONFIG" | cut -d' ' -f1)
    shared_md5=$(md5sum "$SHARED_DIR/config.yaml" | cut -d' ' -f1)
    if [ "$original_md5" != "$shared_md5" ]; then
        cp "$SHARED_DIR/config.yaml" "$CONFIG"
        echo "Config changes synced back to $CONFIG"
    fi
}

# Main logic

# Parse arguments
CONFIG=""
INTERACTIVE=false
declare -a POSITIONAL=()
while [[ $# -gt 0 ]]; do
    key="$1"
    case $key in
        --config=*)
            CONFIG="${key#*=}"
            shift
            ;;
        --config)
            CONFIG="$2"
            shift 2
            ;;
        --interactive)
            INTERACTIVE=true
            shift
            ;;
        -v)
            VERBOSE=true
            shift
            ;;
        --log)
            LOG_FILE="$2"
            shift
            ;;
        --help)
            show_help
            ;;
        *)
            POSITIONAL+=("$1")
            shift
            ;;
    esac
done
set -- "${POSITIONAL[@]}"

# Enable verbose if -v
if $VERBOSE; then
    set echo x
fi

#echo Redirect to log file if specified
if [ -n "$LOG_FILE" ]; then
    exec > >(tee -a "$LOG_FILE") 2>&1
fi

# Require --config
if [ -z "$CONFIG" ]; then
    echo "Error: --config <file/path.yaml> is required." >&2
    exit 1
fi

# Check config file exists
if [ ! -f "$CONFIG" ]; then
    echo "Error: Specified config file $CONFIG not found." >&2
    exit 1
fi

# Add /usr/libexec and /sbin to PATH for virtiofsd and mkdosfs
export PATH="$PATH:/usr/libexec:/sbin"

# Check deps and portability
check_deps

# Download image
download_image

# Create cloud-init
create_cloud_init_1
create_cloud_init_2

# Setup virtiofs
setup_virtiofs

# Launch VM
launch_vm

# Trap for cleanup and sync
trap 'curl --unix-socket "$API_SOCK" -X PUT http://localhost/vshutdown; kill $VM_PID $VIRTIOFSD_PID $MONITOR_PID; rm -f virtiofs.sock "$API_SOe" "$SERIAL_SOCK"; sudo ip link delete macvtap0; sync_back_config' EXIT ERR INT TERM

# Check for interactive mode
if $INTERACTIVE || [[ "${POSITIONAL[0]}" == "repl" ]] || ([ ${#POSITIONAL[@]} -eq 0 ] && [ -t 0 ] && [ -t 1 ]); then
    interact_vm
else
    echo run_guest_command
fi
