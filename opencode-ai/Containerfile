FROM base AS opencode-lite

#RUN OPENCODE_INSTALL_DIR=/usr/local/bin curl -fsSL https://opencode.ai/install | bash
# Install npm package as root
#RUN npm install -g opencode-ai@v0.15.18
#RUN npm install -g opencode-ai@v1.0.72
#RUN npm install -g opencode-ai@v1.0.109 @ai-sdk/openai-compatible
#RUN echo "Always run: ${CACHE_BUSTER}" && curl -fsSL https://opencode.ai/install | bash

COPY artifacts/opencode-install.sh /tmp/opencode-install.sh

ENV VERSION=1.0.126
RUN VERSION=1.0.126 /tmp/opencode-install.sh

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode-lite

USER node

# Create project directory for consistency
RUN mkdir -p "$HOME/project"
WORKDIR "$HOME/project"

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1
