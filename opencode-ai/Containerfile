FROM node:20-slim AS base

# Install minimal system dependencies
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    git libnss3 curl && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /home/node

# Create directories with proper permissions
RUN mkdir -p /home/node/.local/share/opencode && \
    chown -R node:node /home/node

# So git doesn't complain about unusual permissions
RUN git config --system --add safe.directory /home/node

# Set home for cache persistence
ENV HOME=/home/node

#########################
FROM base AS opencode

# Install additional dependencies for Playwright/Chromium
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libatspi2.0-0 libgtk-3-0 fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists/*

# Playwright browser settings
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/pw-browsers
ENV PLAYWRIGHT_SKIP_BROWSER_GC=1

# Create Playwright browsers directory
RUN mkdir -p /home/node/pw-browsers && \
    chown -R node:node /home/node/pw-browsers

USER node

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode

RUN npm install -g opencode-ai@latest playwright && \
    playwright install chromium

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1

#########################
FROM base AS opencode-lite

USER node

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode-lite

RUN npm install -g opencode-ai@latest

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1
