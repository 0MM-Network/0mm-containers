FROM node:22-trixie-slim AS base

# Install minimal system dependencies, including Python and uv for Serena, and build tools for LSP compilation
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    git libnss3 curl python3 python3-pip build-essential clang && \
    pip install uv --break-system-packages && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /home/node/project

# Create directories with proper permissions
RUN mkdir -p /home/node/.local/share/opencode && \
    chown -R node:node /home/node

# So git doesn't complain about unusual permissions
RUN git config --system --add safe.directory /home/node/project

# Set home for cache persistence
ENV HOME=/home/node

# Note: OPENCODE_CONFIG can be set at runtime to specify a custom config file path.
# If set to a host path, the wrapper scripts will mount the dirname of OPENCODE_CONFIG
# read-only at /home/node/.config/opencode/ and set OPENCODE_CONFIG to the mounted file path.
# If OPENCODE_CONFIG is a directory, it sets to /home/node/.config/opencode/opencode.json.
# This ensures custom config takes precedence over global/project configs.

#########################
FROM base AS opencode

# Install additional dependencies for Playwright/Chromium
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    jq libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libatspi2.0-0 libgtk-3-0 fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists/*

# Install npm packages as root
RUN npm install -g opencode-ai@latest playwright chrome-devtools-mcp@latest

# Install Serena by cloning the repository locally for reliability over direct Git fetch
# This approach ensures a stable installation process and avoids potential issues with direct pip install from Git
RUN git clone --depth 1 https://github.com/oraios/serena /tmp/serena && \
    cd /tmp/serena && \
    uv venv /opt/serena-venv && \
    . /opt/serena-venv/bin/activate && \
    uv pip install . && \
    deactivate && \
    rm -rf /tmp/serena

# Install sqlite-mcp-server-enhanced using pip
RUN pip install sqlite-mcp-server-enhanced --break-system-packages

# Install Language Servers (LSPs) for Serena
# Python: pyright via npm
RUN npm install -g pyright

# TypeScript/JavaScript: typescript-language-server via npm
RUN npm install -g typescript typescript-language-server

# Go: gopls via go install
# Use the default packaged Go from the newer base image (node:22-trixie-slim) for better compatibility with modern gopls
# Explicitly set GOPATH for compatibility with newer Go versions in trixie
RUN apt-get update && apt-get install -y golang-go && \
    export GOPATH=/root/go && \
    export PATH="$GOPATH/bin:$PATH" && \
    go install golang.org/x/tools/gopls@latest && \
    [ -f "$(go env GOPATH)/bin/gopls" ] || { echo "gopls not found" && exit 1; } && \
    mv "$(go env GOPATH)/bin/gopls" /usr/local/bin/

# Rust: rustup and rust-analyzer
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    . "$HOME/.cargo/env" && \
    rustup component add rust-analyzer && \
    ln -s ~/.rustup/toolchains/stable-x86_64-unknown-linux-gnu/bin/rust-analyzer /usr/local/bin/rust-analyzer

# C/C++: clangd via apt
RUN apt-get update && apt-get install -y clangd

# Ruby: ruby-lsp via gem (install ruby)
RUN apt-get update && apt-get install -y ruby ruby-dev && \
    gem install ruby-lsp

# Fix permissions after root installs
RUN chown -R node:node /home/node/.npm /home/node/.config /home/node/.cache

# OpenTofu/Terraform: terraform-ls (download binary, pinned version)
RUN curl -L https://releases.hashicorp.com/terraform-ls/0.38.2/terraform-ls_0.38.2_linux_amd64.zip -o /tmp/terraform-ls.zip && \
    unzip /tmp/terraform-ls.zip -d /usr/local/bin/ && \
    rm /tmp/terraform-ls.zip

USER node

# Pre-create npm cache dir with correct ownership
RUN mkdir -p /home/node/.npm && chown -R node:node /home/node/.npm

ENV NPM_CONFIG_PREFIX=/home/node/.npm-global
ENV PATH=$PATH:/home/node/.npm-global/bin
RUN mkdir -p /home/node/.npm-global && npm config set prefix '/home/node/.npm-global'

# Bash: bash-language-server via npm
# Cucumber: cucumber-language-server via npm (assuming from npm as README 404, standard install)
RUN npm install -g bash-language-server @cucumber/language-server task-master-ai @byterover/cipher markdownlint-cli2 repomix

# Provide default Serena MCP configuration (YAML file in ~/.serena)
RUN mkdir -p /home/node/.serena && \
    chown -R node:node /home/node/.serena

# Set Playwright settings
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/pw-browsers
ENV PLAYWRIGHT_SKIP_BROWSER_GC=1

# Create Playwright browsers directory and install chromium as root
RUN mkdir -p /home/node/pw-browsers && \
    playwright install chromium && \
    chown -R node:node /home/node || true

RUN export GOPATH=/home/node/go && \
    export PATH="$GOPATH/bin:$PATH" && \
    curl -fsSL https://raw.githubusercontent.com/steveyegge/beads/main/install.sh | bash && \
    [ -f "$(go env GOPATH)/bin/bd" ] || { echo "bd not found" && exit 1; } && \
    mv "$(go env GOPATH)/bin/bd" /usr/local/bin/

RUN uv tool install specify-cli --from git+https://github.com/github/spec-kit.git
ENV PATH="$HOME/.uv/tools/specify-cli/bin:$PATH"
RUN ln -s $HOME/.uv/tools/specify-cli/bin/specify /usr/local/bin/specify

# Environment variables for LSP caches (to be mounted persistently)
ENV RUSTUP_HOME=/home/node/.rustup
ENV CARGO_HOME=/home/node/.cargo
ENV GOPATH=/home/node/go

# Test key LSP installations
RUN gopls version && \
    rust-analyzer --version && \
    clangd --version && \
    ruby-lsp --version && \
    bash-language-server --version && \
    terraform-ls --version && \
    chown -R node:node /home/node/.npm

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode

# Allow running Serena via 'serena start-mcp-server' (e.g., for stdio or --transport streamable-http for HTTP mode)
ENV PATH="/opt/serena-venv/bin:$PATH:/home/node/go/bin:/home/node/.cargo/bin"

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1

#########################
FROM base AS opencode-lite

# Install npm package as root
RUN npm install -g opencode-ai@latest

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode-lite

USER node

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1
