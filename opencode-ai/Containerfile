FROM node:22-trixie-slim AS base

# Install minimal system dependencies, including Python and uv for Serena, and build tools for LSP compilation
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    git hx libnss3 curl python3 python3-pip build-essential clang && \
    pip install uv --break-system-packages && \
    npm install -g npm@11.6.4 && \
    rm -rf /var/lib/apt/lists/*

# So git doesn't complain about unusual permissions
RUN git config --system --add safe.directory /home/node/project

# Set home for cache persistence
ENV HOME=/home/node
ENV VISUAL=hx
ENV EDITOR=hx
ENV GIT_EDITOR=hx

# Note: OPENCODE_CONFIG can be set at runtime to specify a custom config file path.
# If set to a host path, the wrapper scripts will mount the dirname of OPENCODE_CONFIG
# read-only at /home/node/.config/opencode/ and set OPENCODE_CONFIG to the mounted file path.
# If OPENCODE_CONFIG is a directory, it sets to /home/node/.config/opencode/opencode.json.
# This ensures custom config takes precedence over global/project configs.

#########################
FROM base AS preopencode

# Install additional dependencies for Playwright/Chromium
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    dos2unix jq libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libatspi2.0-0 libgtk-3-0 fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists/*

# Consolidate apt installs for Go, Ruby, Clangd
RUN apt-get update && apt-get install -y golang-go ruby ruby-dev clangd && rm -rf /var/lib/apt/lists/*

# Install Language Servers (LSPs) for Serena
# TypeScript/JavaScript: typescript-language-server via npm
# Python: pyright via npm
RUN HOME=/root npm install --prefix /home/node/.cache/opencode pyright typescript typescript-language-server opencode-skills@0.1.1

# Install sqlite-mcp-server-enhanced using pip
RUN HOME=/root pip install sqlite-mcp-server-enhanced --break-system-packages

# OpenTofu/Terraform: terraform-ls (download binary, pinned version)
RUN curl -L https://releases.hashicorp.com/terraform-ls/0.38.2/terraform-ls_0.38.2_linux_amd64.zip -o /tmp/terraform-ls.zip && \
    unzip /tmp/terraform-ls.zip -d /usr/local/bin/ && \
    rm /tmp/terraform-ls.zip
    
# Set ENV for user homes early
ENV RUSTUP_HOME=/home/node/.rustup
ENV CARGO_HOME=/home/node/.cargo
ENV GOPATH=/home/node/go
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/pw-browsers
ENV PLAYWRIGHT_SKIP_BROWSER_GC=1
ENV PATH="${PATH}:/usr/local/bin:/home/node/.local/bin:/home/node/.cache/opencode/node_modules/.bin"

# Rearranged for rootless Podman compatibility: perform user-specific installs after USER node to avoid chown issues.

# Use HOME=/root for root commands to avoid creating root-owned files in /home/node, enabling safe mkdir as node.

USER node
ENV HOME=/home/node

# Create user directories after USER node to ensure ownership by node, avoiding root-owned parents and chown for rootless builds.
RUN mkdir -p "$HOME/project" "$HOME/.local/share/opencode" "$HOME/.npm" "$HOME/.bun" "$HOME/.config/opencode" "$HOME/.cache/opencode" "$HOME/.serena" "$HOME/pw-browsers" "$HOME/.local/share/uv/tools" "$HOME/.rustup" "$HOME/.cargo" "$HOME/go" "$HOME/.gem"

# Install Serena by cloning the repository locally for reliability over direct Git fetch
# This approach ensures a stable installation process and avoids potential issues with direct pip install from Git
RUN git clone --depth 1 https://github.com/oraios/serena /tmp/serena && \
    cd /tmp/serena && \
    uv venv $HOME/.serena/venv && \
    . $HOME/.serena/venv/bin/activate && \
    uv pip install . && \
    deactivate && \
    rm -rf /tmp/serena

# Set working directory
WORKDIR "$HOME/project"

RUN npm install --prefix "$HOME/.cache/opencode" playwright chrome-devtools-mcp@latest bash-language-server @cucumber/language-server task-master-ai @byterover/cipher markdownlint-cli2 repomix opencode-skills@0.1.1

# Ruby: ruby-lsp via gem (user install)
#RUN gem install --user-install ruby-lsp

# Go: gopls via go install
RUN export PATH="${PATH}:${GOPATH}/bin" && \
    go install golang.org/x/tools/gopls@latest && \
    [ -f "${GOPATH}/bin/gopls" ] || { echo "gopls not found" && exit 1; }

# Install beads
RUN export PATH="${PATH}:${GOPATH}/bin" && \
    curl -fsSL https://raw.githubusercontent.com/steveyegge/beads/main/scripts/install.sh | bash && \
    [ -f "/home/node/.local/bin/bd" ] || { echo "bd not found" && exit 1; }

# Rust: rustup and rust-analyzer
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    . "${CARGO_HOME}/env" && \
    rustup component add rust-analyzer && \
    [ -f "${RUSTUP_HOME}/toolchains/stable-x86_64-unknown-linux-gnu/bin/rust-analyzer" ] || { echo "rust-analyzer not found" && exit 1; }

# Provide default Serena MCP configuration (YAML file in ~/.serena)
# Directory already created

# Create Playwright browsers directory and install chromium
RUN playwright install chromium

RUN uv tool install specify-cli --from git+https://github.com/github/spec-kit.git
ENV PATH="${HOME}/.uv/tools/specify-cli/bin:${PATH}"

USER root
RUN ln -s $HOME/.uv/tools/specify-cli/bin/specify /usr/local/bin/specify
USER node
ENV PATH="/usr/local/bin:${PATH}"
RUN test -L /usr/local/bin/specify && echo "Symlink created successfully" || exit 1

#RUN npm install -g opencode-ai@v1.0.109 @ai-sdk/openai-compatible

# Install Bun for pre-installing plugins
RUN curl -fsSL https://bun.sh/install | bash

# Pre-install Opencode plugins to avoid runtime installations
#RUN cd "$HOME/.config/opencode" && "$HOME/.bun/bin/bun" add @opencode-ai/plugin@1.0.109 roject/.opencode" && cd "$HOME/project/.opencode" && "$HOME/.bun/bin/bun" add @opencode-ai/plugin@1.0.109 --exact

RUN cd "$HOME/.cache/opencode" && "$HOME/.bun/bin/bun" add opencode-skills@0.1.1 --force --exact

#RUN cd "$HOME/.cache/opencode" && "$HOME/.bun/bin/bun" add opencode-copilot-auth@0.0.5 --force --exact

#RUN cd "$HOME/.cache/opencode" && "$HOME/.bun/bin/bun" add opencode-anthropic-auth@0.0.2 --force --exact

FROM preopencode AS opencode

COPY artifacts/opencode-install.sh /tmp/opencode-install.sh

ENV VERSION=1.0.126
RUN VERSION=1.0.126 /tmp/opencode-install.sh

USER root
RUN cp /home/node/.opencode/bin/opencode /usr/local/bin/opencode && \
    chmod +x /usr/local/bin/opencode && \
    echo '#!/bin/bash\nsource /home/node/.bashrc\nexec opencode "$@"' > /usr/local/bin/opencode-wrapper && \
    chmod +x /usr/local/bin/opencode-wrapper
USER node

# Environment variables for LSP caches (to be mounted persistently)
ENV RUSTUP_HOME=/home/node/.rustup
ENV CARGO_HOME=/home/node/.cargo
ENV GOPATH=/home/node/go
ENV BUN_INSTALL_CACHE_DIR=/home/node/.cache/opencode/bun-cache

# Add Ruby's version-specific gem bin dir to PATH to make all user-installed gem executables (e.g., ruby-lsp and dependencies) accessible, avoiding 'not found' warnings and errors.
# Set PATH to include user bins
ENV PATH="$HOME/.serena/venv/bin:${PATH}:${GOPATH}/bin:${CARGO_HOME}/bin:${RUSTUP_HOME}/toolchains/stable-x86_64-unknown-linux-gnu/bin:/home/node/.bun/bin:/home/node/.cache/opencode/node_modules/.bin"

# Temporarily comment out ruby-lsp test due to persistent PATH issues; LSP is still installed.
# Test key LSP installations
RUN gopls version && \
    rust-analyzer --version && \
    clangd --version && \
    bash-language-server --version && \
    terraform-ls --version && \
    playwright --version

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode

# Allow running Serena via 'serena start-mcp-server' (e.g., for stdio or --transport streamable-http for HTTP mode)
ENV PATH="$HOME/.serena/venv/bin:$PATH:/home/node/go/bin:/home/node/.cargo/bin"

# ENTRYPOINT points to user-specific install path after moving npm install to USER node for rootless compatibility.
ENTRYPOINT ["/usr/local/bin/opencode-wrapper"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1

