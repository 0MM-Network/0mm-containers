FROM node:20-slim AS base

# Install minimal system dependencies, including Python and uv for Serena
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    git libnss3 curl python3 python3-pip && \
    pip install uv --break-system-packages && \
    rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /home/node/project

# Create directories with proper permissions
RUN mkdir -p /home/node/.local/share/opencode && \
    chown -R node:node /home/node

# So git doesn't complain about unusual permissions
RUN git config --system --add safe.directory /home/node/project

# Set home for cache persistence
ENV HOME=/home/node

# Note: OPENCODE_CONFIG can be set at runtime to specify a custom config file path.
# If set to a host path, the wrapper scripts will mount the dirname of OPENCODE_CONFIG
# read-only at /home/node/.config/opencode/ and set OPENCODE_CONFIG to the mounted file path.
# If OPENCODE_CONFIG is a directory, it sets to /home/node/.config/opencode/opencode.json.
# This ensures custom config takes precedence over global/project configs.

#########################
FROM base AS opencode

# Install additional dependencies for Playwright/Chromium
RUN apt-get update && \
    apt-get install --no-install-recommends -y \
    jq libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libxkbcommon0 \
    libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 \
    libcairo2 libasound2 libatspi2.0-0 libgtk-3-0 fonts-liberation fonts-noto-color-emoji && \
    rm -rf /var/lib/apt/lists/*

# Install npm packages as root
RUN npm install -g opencode-ai@latest playwright chrome-devtools-mcp@latest

# Install Serena using uv
RUN uv venv /opt/serena-venv && \
    . /opt/serena-venv/bin/activate && \
    uv pip install git+https://github.com/oraios/serena && \
    deactivate

# Install sqlite-mcp-server-enhanced using pip
RUN pip install sqlite-mcp-server-enhanced --break-system-packages

# Provide default Serena MCP configuration (YAML file in ~/.serena)
RUN mkdir -p /home/node/.serena && \
    echo "context: ide-assistant" > /home/node/.serena/serena_config.yml && \
    echo "included_optional_tools:" >> /home/node/.serena/serena_config.yml && \
    echo "  - execute_shell_command" >> /home/node/.serena/serena_config.yml && \
    chown -R node:node /home/node/.serena

# Set Playwright settings
ENV PLAYWRIGHT_BROWSERS_PATH=/home/node/pw-browsers
ENV PLAYWRIGHT_SKIP_BROWSER_GC=1

# Create Playwright browsers directory and install chromium as root
RUN mkdir -p /home/node/pw-browsers && \
    playwright install chromium && \
    chown -R node:node /home/node

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode

USER node

# Allow running Serena via 'serena start-mcp-server' (e.g., for stdio or --transport streamable-http for HTTP mode)
ENV PATH="/opt/serena-venv/bin:$PATH"

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1

#########################
FROM base AS opencode-lite

# Install npm package as root
RUN npm install -g opencode-ai@latest

ENV OPENCODE_DOCKER_IMAGE=localhost/opencode-lite

USER node

ENTRYPOINT ["/usr/local/bin/opencode"]

HEALTHCHECK --interval=30s --timeout=3s CMD curl -f http://localhost:4096/doc || exit 1
